# Application Settings
APP_NAME="SalesBattlecard API"
APP_ENV=development
PORT=8000
DEBUG=True

# CORS Configuration (Allowed Origins, e.g. React client)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3000"

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=paramantra_salesbattle

# Configurable Table Names (Easily adjust to match your local Paramantra CRM schema)
TABLE_LEADS=leads
TABLE_INTERACTIONS=lead_interactions

# Configurable Column Names for Leads Table
COL_LEAD_ID=id
COL_LEAD_NAME=name
COL_LEAD_COMPANY=company
COL_LEAD_STATUS=status
COL_LEAD_STAGE=stage
COL_LEAD_ASSIGNED_TO=assigned_to

# Configurable Column Names for Interactions Table
COL_INT_ID=id
COL_INT_LEAD_ID=lead_id
COL_INT_CONTENT=notes
COL_INT_TYPE=interaction_type
COL_INT_DIRECTION=direction
COL_INT_CREATED_AT=created_at

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional summarization model. Blank reuses OPENAI_MODEL; validate any change with evals.
OPENAI_SUMMARY_MODEL=

# Single operator authentication. Required outside development; use HTTPS when hosted.
# The authenticated operator has access to this configured CRM database.
AUTH_USERNAME=
AUTH_PASSWORD=

# Only enable sources that exist in your CRM. Enabled source failures stop analysis.
# Add generic to read TABLE_INTERACTIONS using the COL_INT_* mapping.
INTERACTION_SOURCES=whats_app,ticket_email,pm1call_log,pm1cti_event,customer_thread,rep_thread

# Disabled by default, including in development. Enables synthetic payload analysis.
ENABLE_TEST_ANALYZE=false
MAX_EVIDENCE_BYTES=240000
